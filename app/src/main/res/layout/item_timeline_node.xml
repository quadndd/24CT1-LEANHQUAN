<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Timeline Indicator Column -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Top Connector Line -->
        <View
            android:id="@+id/viewTopLine"
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="@color/border_gray" />

        <!-- Node Dot -->
        <View
            android:id="@+id/viewNodeDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_circle_inactive" />

        <!-- Bottom Connector Line -->
        <View
            android:id="@+id/viewBottomLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/border_gray" />
    </LinearLayout>

    <!-- Node Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimelineTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đã đặt đơn"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelineTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22/08/2026 14:30"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimelineDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Đơn hàng #DH24CT1001 đã được đặt thành công"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
